# Copia questo file in .env e compila i valori veri (non committare mai .env)

# Connessione MongoDB Atlas
MONGODB_URI=mongodb+srv://utente:password@cluster0.wzzyhev.mongodb.net/fantasfotto

# Segreto per firmare i JWT (usa una stringa lunga e casuale)
JWT_SECRET=pietro-e-mattia-campioni

# Codice invito richiesto per iscriversi alla lega
CODICE_INVITO=ILCAMPIONESEITU

# Codice richiesto per iscriversi come "redattore" (chi compila le giornate e
# manda in stampa le edizioni). Se lo lasci vuoto o non lo definisci, il ruolo si
# può scegliere liberamente in fase di iscrizione.
CODICE_REDAZIONE=

# Stagione in corso, nel formato 2026-27. Facoltativa: se la lasci vuota si ricava
# dalla data (la stagione cambia il 1° luglio). Serve per forzarla, per esempio
# per chiudere una stagione in ritardo o per provare il cambio in locale.
STAGIONE_CORRENTE=

# Porta locale (ignorata su Vercel)
PORT=3001

# Upload immagini (opzionale, vedi src/services/cloudinary.js).
# Qui vanno SEGNAPOSTO: questo file è committato. Le chiavi vere stanno in .env
# in locale e nelle Environment Variables del progetto *backend* su Vercel.
# In alternativa alle tre variabili separate si può usare la sola CLOUDINARY_URL,
# che si copia con un clic dalla dashboard: cloudinary://chiave:secret@cloud
CLOUDINARY_CLOUD_NAME=il-tuo-cloud-name
CLOUDINARY_API_KEY=la-tua-api-key
CLOUDINARY_API_SECRET=il-tuo-api-secret

# Generazione articolo assistita da LLM (opzionale, non ancora attiva nella v1)
# ANTHROPIC_API_KEY=

# Notifiche push (opzionali). Genera le chiavi con `npm run vapid` e incollale qui
# (e nelle Environment Variables del backend su Vercel). Senza chiavi le notifiche
# restano spente e il resto dell'app funziona uguale.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tua@email.it
